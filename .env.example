# OpenAI-compatible LLM configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash

# RAG vector store configuration
# Name of the Chroma collection holding merchant knowledge.
RAG_COLLECTION_NAME=merchant_knowledge
# Directory where Chroma persists its data. Defaults to ./data/vector_store.
VECTOR_STORE_DIR=./data/vector_store
# Sentence-transformers embedding model used to embed merchant documents.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Number of similar merchants retrieved per RAG query.
RAG_TOP_K=3
# Cosine-similarity threshold; matches at/above it are treated as strong RAG.
RAG_SIMILARITY_THRESHOLD=0.70